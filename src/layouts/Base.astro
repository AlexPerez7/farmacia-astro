---
import '../styles/global.css';
import CarroBoton from '../components/CarroBoton';
import CarroDrawer from '../components/CarroDrawer';
import { CATEGORIAS } from '../lib/categorias';
import { ENVIO_GRATIS_DESDE, NOMBRE_TIENDA, clp } from '../lib/tienda';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = 'Tu farmacia en línea: medicamentos, dermocosmética, vitaminas y más, con despacho a domicilio.' } = Astro.props;
const tituloCompleto = title ? `${title} | ${NOMBRE_TIENDA}` : `${NOMBRE_TIENDA} — Farmacia en línea`;
const rutaActual = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f766e" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{tituloCompleto}</title>
  </head>
  <body class="flex min-h-dvh flex-col font-sans antialiased">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2">
      Saltar al contenido
    </a>

    <div class="bg-marca-900 px-4 py-1.5 text-center text-xs font-medium text-marca-50">
      Despacho gratis en compras sobre {clp(ENVIO_GRATIS_DESDE)} · Sitio de demostración
    </div>

    <header class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur">
      <div class="mx-auto flex max-w-7xl items-center gap-4 px-4 py-3">
        <a href={url('')} class="flex shrink-0 items-center gap-2" aria-label={`${NOMBRE_TIENDA}, inicio`}>
          <img src={url('favicon.svg')} alt="" width="32" height="32" />
          <span class="text-lg font-extrabold tracking-tight text-marca-800">Farmacia <span class="text-marca-600">Pulso</span></span>
        </a>
        <form action={url('productos/')} method="get" role="search" class="hidden flex-1 md:block">
          <input
            type="search"
            name="q"
            placeholder="¿Qué estás buscando?"
            class="w-full max-w-xl rounded-full border border-slate-300 bg-slate-50 px-4 py-2 text-sm outline-none focus:border-marca-600 focus:bg-white focus:ring-2 focus:ring-marca-100"
            aria-label="Buscar productos"
          />
        </form>
        <nav class="ml-auto flex items-center gap-2 md:ml-0">
          <a href={url('productos/')} class="rounded-full px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100">Productos</a>
          <CarroBoton client:only="react" />
        </nav>
      </div>
      <form action={url('productos/')} method="get" role="search" class="px-4 pb-3 md:hidden">
        <input
          type="search"
          name="q"
          placeholder="¿Qué estás buscando?"
          class="w-full rounded-full border border-slate-300 bg-slate-50 px-4 py-2 text-base outline-none focus:border-marca-600 focus:bg-white"
          aria-label="Buscar productos"
        />
      </form>
      <nav aria-label="Categorías" class="border-t border-slate-100">
        <ul class="mx-auto flex max-w-7xl gap-1 overflow-x-auto px-4 py-2 text-sm [scrollbar-width:none]">
          {
            CATEGORIAS.map((c) => {
              const href = url(`categoria/${c.id}/`);
              return (
                <li class="shrink-0">
                  <a
                    href={href}
                    class:list={[
                      'block rounded-full px-3 py-1 font-medium',
                      rutaActual === href ? 'bg-marca-100 text-marca-800' : 'text-slate-600 hover:bg-slate-100',
                    ]}
                    aria-current={rutaActual === href ? 'page' : undefined}
                  >
                    {c.nombre}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </header>

    <main id="contenido" class="mx-auto w-full max-w-7xl flex-1 px-4 py-6 sm:py-8">
      <slot />
    </main>

    <footer class="mt-12 border-t border-slate-200 bg-white">
      <div class="mx-auto grid max-w-7xl gap-8 px-4 py-10 text-sm text-slate-600 sm:grid-cols-3">
        <div>
          <p class="font-bold text-marca-800">{NOMBRE_TIENDA}</p>
          <p class="mt-2">Químico farmacéutico responsable: Q.F. Ficticio Ejemplo.</p>
          <p>Atención: lunes a domingo, 9:00 a 22:00.</p>
        </div>
        <div>
          <p class="font-semibold text-slate-900">Tienda</p>
          <ul class="mt-2 space-y-1">
            <li><a href={url('productos/')} class="hover:text-marca-700">Todos los productos</a></li>
            <li><a href={url('carro/')} class="hover:text-marca-700">Mi carro</a></li>
            <li><a href={url('categoria/medicamentos/')} class="hover:text-marca-700">Medicamentos</a></li>
          </ul>
        </div>
        <div class="rounded-xl bg-amber-50 p-4 text-amber-900">
          <p class="font-semibold">Proyecto de portafolio</p>
          <p class="mt-1">
            {NOMBRE_TIENDA} es una marca ficticia. Productos, precios, laboratorios y sucursales son inventados. No se venden medicamentos ni se procesan pagos.
          </p>
        </div>
      </div>
    </footer>

    <CarroDrawer client:only="react" />
  </body>
</html>
