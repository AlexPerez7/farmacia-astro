---
import { getCollection } from 'astro:content';
import '../styles/global.css';
import BarraAviso from '../components/BarraAviso.astro';
import BuscadorSugerencias from '../components/BuscadorSugerencias';
import CarroBoton from '../components/CarroBoton';
import CarroDrawer from '../components/CarroDrawer';
import FavoritosBoton from '../components/FavoritosBoton';
import MenuCategorias, { type EntradaMenu } from '../components/MenuCategorias';
import PieDePagina from '../components/PieDePagina.astro';
import SelectorComuna from '../components/SelectorComuna';
import SelectorTema from '../components/SelectorTema';
import { CATEGORIAS } from '../lib/categorias';
import { NOMBRE_TIENDA } from '../lib/tienda';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = 'Tu farmacia en línea: medicamentos, dermocosmética, vitaminas y más, con despacho a domicilio.' } = Astro.props;
const tituloCompleto = title ? `${title} | ${NOMBRE_TIENDA}` : `${NOMBRE_TIENDA} — Farmacia en línea`;

// Datos para el menú y el buscador del header: solo los campos que usan, para no inflar el HTML de cada página.
const productos = (await getCollection('productos')).map((p) => ({ id: p.id, ...p.data }));
const buscables = productos.map(({ id, nombre, laboratorio, principioActivo, descripcion, precio, categoria }) => ({
  id,
  nombre,
  laboratorio,
  principioActivo,
  descripcion,
  precio,
  categoria,
}));
const menu: EntradaMenu[] = CATEGORIAS.map((c) => {
  const deCategoria = productos.filter((p) => p.categoria === c.id);
  const subcategorias = [...new Set(deCategoria.map((p) => p.subcategoria))].map((nombre) => ({
    nombre,
    cantidad: deCategoria.filter((p) => p.subcategoria === nombre).length,
  }));
  const destacados = [...deCategoria.filter((p) => p.masVendido || p.destacado), ...deCategoria].filter((p, i, l) => l.indexOf(p) === i).slice(0, 4);
  return { id: c.id, nombre: c.nombre, descripcion: c.descripcion, subcategorias, destacados: destacados.map((p) => ({ id: p.id, nombre: p.nombre })) };
});

const servicios = [
  { href: url('seguimiento/'), texto: 'Seguimiento de pedido' },
  { href: url('sucursales/'), texto: 'Sucursales' },
  { href: url('ayuda/#receta'), texto: 'Reserva con receta' },
];
const rutaActual = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Fija el tema antes del primer pintado para evitar el destello. Misma clave que src/stores/tema.ts. -->
    <script is:inline>
      (() => {
        let tema = 'sistema';
        try {
          tema = localStorage.getItem('pulso:tema') || 'sistema';
        } catch {}
        const oscuro = tema === 'oscuro' || (tema !== 'claro' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = oscuro ? 'dark' : 'light';
        // Misma clave que components/BarraAviso.astro.
        try {
          if (localStorage.getItem('pulso:aviso-cerrado')) document.documentElement.dataset.aviso = 'cerrado';
        } catch {}
      })();
    </script>
    <meta name="description" content={description} />
    <!-- Coincide con la franja superior (marca-900), igual en ambos temas. -->
    <meta name="theme-color" content="#134e4a" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{tituloCompleto}</title>
  </head>
  <body class="flex min-h-dvh flex-col font-sans antialiased">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-superficie focus:px-4 focus:py-2">
      Saltar al contenido
    </a>

    <BarraAviso />

    <header class="sticky top-0 z-40 border-b border-borde bg-superficie">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-1 gap-y-2 px-4 py-3 sm:gap-x-3">
        <MenuCategorias categorias={menu} client:load />
        <a href={url('')} class="flex shrink-0 items-center gap-2" aria-label={`${NOMBRE_TIENDA}, inicio`}>
          <img src={url('favicon.svg')} alt="" width="32" height="32" class="size-7 sm:size-8" />
          <span class="hidden text-base font-extrabold tracking-tight text-texto min-[340px]:inline sm:text-lg">Farmacia <span class="text-acento">Pulso</span></span>
        </a>
        <!-- Un solo buscador: en el celular baja a su propia fila (order-last + w-full). -->
        <div class="order-last w-full md:order-none md:w-auto md:max-w-xl md:flex-1">
          <BuscadorSugerencias productos={buscables} client:load />
        </div>
        <nav aria-label="Tu cuenta" class="ml-auto flex items-center gap-0.5 sm:gap-1">
          <!-- En el celular el tema se cambia desde el menú de categorías, para que el header quepa en una fila. -->
          <div class="hidden sm:block">
            <SelectorTema client:only="react">
              <span slot="fallback" class="block size-10"></span>
            </SelectorTema>
          </div>
          <FavoritosBoton client:only="react">
            <span slot="fallback" class="block size-10"></span>
          </FavoritosBoton>
          <CarroBoton client:only="react">
            <span slot="fallback" class="block h-9 w-14 rounded-full bg-marca-700 sm:w-24"></span>
          </CarroBoton>
        </nav>
      </div>
      <div class="border-t border-borde">
        <div class="mx-auto flex max-w-7xl items-center gap-3 px-4 py-1.5">
          <div class="shrink-0">
            <SelectorComuna client:only="react">
              <span slot="fallback" class="block h-7 w-24"></span>
            </SelectorComuna>
          </div>
          <nav aria-label="Servicios" class="min-w-0 flex-1">
            <ul
              class="flex justify-end gap-1 overflow-x-auto text-sm [scrollbar-width:none] max-md:justify-start max-md:[mask-image:linear-gradient(to_right,transparent,black_12px,black_calc(100%-24px),transparent)]"
            >
              {
                servicios.map((s) => (
                  <li class="shrink-0">
                    <a
                      href={s.href}
                      class:list={[
                        'block rounded-full px-3 py-1 font-medium',
                        rutaActual === s.href ? 'bg-acento-suave text-acento' : 'text-texto-2 hover:bg-superficie-2',
                      ]}
                      aria-current={rutaActual === s.href ? 'page' : undefined}
                    >
                      {s.texto}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </div>
    </header>

    <main id="contenido" tabindex="-1" class="outline-none mx-auto w-full max-w-7xl flex-1 px-4 py-6 sm:py-8">
      <slot />
    </main>

    <PieDePagina />

    <CarroDrawer client:only="react" />
  </body>
</html>
