---
import Base from './Base.astro';

interface Props {
  title: string;
  description?: string;
  actualizado?: string;
}

const { title, description, actualizado } = Astro.props;
---

<!-- Páginas de texto (ayuda y legales): ancho de lectura y estilos de prosa. -->
<Base title={title} description={description}>
  <article
    class="mx-auto max-w-3xl text-texto-2 [&_a]:font-semibold [&_a]:text-acento [&_a:hover]:underline [&_h2]:mt-10 [&_h2]:scroll-mt-40 [&_h2]:text-xl [&_h2]:font-bold [&_h2]:text-texto [&_h3]:mt-6 [&_h3]:font-semibold [&_h3]:text-texto [&_li]:mt-1 [&_p]:mt-3 [&_p]:leading-relaxed [&_ul]:mt-3 [&_ul]:list-disc [&_ul]:pl-5"
  >
    <h1 class="text-3xl font-bold text-texto">{title}</h1>
    {actualizado && <p class="text-sm text-tenue">Última actualización: {actualizado}</p>}
    <div class="mt-4 rounded-xl bg-aviso-fondo p-4 text-sm text-aviso-texto">
      Texto ficticio de un proyecto de portafolio. No tiene validez legal ni sanitaria.
    </div>
    <slot />
  </article>
</Base>
