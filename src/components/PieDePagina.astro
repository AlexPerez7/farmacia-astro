---
import { NOMBRE_TIENDA } from '../lib/tienda';
import { url } from '../lib/url';

const columnas = [
  {
    titulo: 'Ayuda',
    enlaces: [
      { href: url('ayuda/'), texto: 'Preguntas frecuentes' },
      { href: url('seguimiento/'), texto: 'Seguimiento de pedido' },
      { href: url('ayuda/#despacho'), texto: 'Despacho y retiro' },
      { href: url('ayuda/#receta'), texto: 'Reserva con receta' },
    ],
  },
  {
    titulo: 'La farmacia',
    enlaces: [
      { href: url('sucursales/'), texto: 'Sucursales y horarios' },
      { href: url('productos/'), texto: 'Todos los productos' },
      { href: url('favoritos/'), texto: 'Mis favoritos' },
      { href: url('carro/'), texto: 'Mi carro' },
    ],
  },
  {
    titulo: 'Legal',
    enlaces: [
      { href: url('terminos/'), texto: 'Términos y condiciones' },
      { href: url('privacidad/'), texto: 'Política de privacidad' },
    ],
  },
];

// Íconos genéricos: sin logos de marcas de tarjetas ni de pasarelas.
const mediosDePago = [
  { nombre: 'Tarjeta de débito', icono: 'M2 7h20M2 5h20v14H2zM6 15h4' },
  { nombre: 'Tarjeta de crédito', icono: 'M2 5h20v14H2zM2 10h20M16 15h2' },
  { nombre: 'Transferencia', icono: 'M3 10h18M5 10v8M9 10v8M15 10v8M19 10v8M3 21h18M12 3l9 5H3z' },
];
---

<footer class="mt-12 border-t border-borde bg-superficie">
  <div class="mx-auto grid max-w-7xl grid-cols-2 gap-8 px-4 py-10 text-sm text-texto-2 md:grid-cols-4">
    {
      columnas.map((c) => (
        <div>
          <p class="font-semibold text-texto">{c.titulo}</p>
          <ul class="mt-3 space-y-2">
            {c.enlaces.map((e) => (
              <li>
                <a href={e.href} class="hover:text-acento">
                  {e.texto}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
    <div>
      <p class="font-semibold text-texto">Medios de pago</p>
      <ul class="mt-3 space-y-2">
        {
          mediosDePago.map((m) => (
            <li class="flex items-center gap-2">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-5 text-acento" aria-hidden="true">
                <path d={m.icono} />
              </svg>
              {m.nombre}
            </li>
          ))
        }
      </ul>
      <p class="mt-2 text-xs text-tenue">Pagos simulados: no se cobra nada.</p>
    </div>
  </div>

  <div class="border-t border-borde">
    <div class="mx-auto grid max-w-7xl gap-6 px-4 py-8 text-sm text-texto-2 md:grid-cols-[1fr_1fr]">
      <div class="space-y-1">
        <p class="font-bold text-acento">{NOMBRE_TIENDA}</p>
        <p>Químico farmacéutico responsable: Q.F. Ficticio Ejemplo (dato ficticio).</p>
        <p>Resolución sanitaria N.º 0000/2026 (ficticia).</p>
        <p>Ante una intoxicación o una emergencia, acude al servicio de urgencia más cercano o llama al número de emergencias de tu país.</p>
      </div>
      <div class="rounded-xl bg-aviso-fondo p-4 text-aviso-texto">
        <p class="font-semibold">Proyecto de portafolio</p>
        <p class="mt-1">
          {NOMBRE_TIENDA} es una marca ficticia. Productos, precios, laboratorios y sucursales son inventados. No se venden medicamentos ni se procesan pagos.
        </p>
      </div>
    </div>
  </div>
</footer>
