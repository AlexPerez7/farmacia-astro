---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ListaFavoritos from '../components/ListaFavoritos';
import { aProducto } from '../lib/tipos';

const productos = (await getCollection('productos')).map(aProducto);
---

<Base title="Mis favoritos">
  <h1 class="mb-6 text-3xl font-bold text-texto">Mis favoritos</h1>
  <ListaFavoritos productos={productos} client:only="react">
    <p slot="fallback" class="text-tenue">Cargando favoritos…</p>
  </ListaFavoritos>
</Base>
