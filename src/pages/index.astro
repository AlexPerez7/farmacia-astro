---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProductoCard from '../components/ProductoCard';
import ProductoVisual from '../components/ProductoVisual';
import { CATEGORIAS } from '../lib/categorias';
import { ENVIO_GRATIS_DESDE, clp } from '../lib/tienda';
import { aProducto } from '../lib/tipos';
import { url } from '../lib/url';

const productos = (await getCollection('productos')).map(aProducto);
const destacados = productos.filter((p) => p.destacado);
const conteo = (cat: string) => productos.filter((p) => p.categoria === cat).length;
---

<Base>
  <section class="overflow-hidden rounded-3xl bg-gradient-to-br from-marca-700 to-marca-900 dark:from-marca-800 dark:to-marca-950 px-6 py-12 text-white sm:px-12 sm:py-16">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-marca-200">Farmacia en línea</p>
      <h1 class="mt-3 text-3xl font-extrabold leading-tight sm:text-5xl">Tu salud, a un clic y sin filas.</h1>
      <p class="mt-4 text-lg text-marca-100">
        Medicamentos, dermocosmética y cuidado personal con despacho a domicilio. Reserva en línea tus medicamentos con receta y retíralos en sucursal.
      </p>
      <form action={url('productos/')} method="get" role="search" class="mt-8 flex max-w-lg gap-2">
        <input
          type="search"
          name="q"
          placeholder="Ej: paracetamol, protector solar…"
          class="min-w-0 flex-1 rounded-full bg-superficie px-5 py-3 text-base text-texto outline-none ring-4 ring-transparent focus:ring-marca-500/40"
          aria-label="Buscar productos"
        />
        <!-- Texto oscuro fijo: el botón ámbar es igual en ambos temas. -->
        <button class="shrink-0 rounded-full bg-amber-400 px-6 py-3 font-bold text-slate-900 hover:bg-amber-300">Buscar</button>
      </form>
    </div>
  </section>

  <ul class="mt-6 grid gap-3 text-sm sm:grid-cols-3">
    <li class="rounded-2xl border border-borde bg-superficie p-4"><strong class="block text-texto">Despacho gratis</strong>En compras sobre {clp(ENVIO_GRATIS_DESDE)}</li>
    <li class="rounded-2xl border border-borde bg-superficie p-4"><strong class="block text-texto">Retiro en sucursal</strong>Sin costo, en 3 sucursales</li>
    <li class="rounded-2xl border border-borde bg-superficie p-4"><strong class="block text-texto">Reserva con receta</strong>Presenta tu receta al retirar</li>
  </ul>

  <section class="mt-12">
    <h2 class="text-2xl font-bold text-texto">Categorías</h2>
    <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
      {
        CATEGORIAS.map((c) => (
          <a href={url(`categoria/${c.id}/`)} class="group rounded-2xl border border-borde bg-superficie p-4 transition-shadow hover:shadow-md">
            <ProductoVisual categoria={c.id} tamano="sm" className="size-14" />
            <p class="mt-3 font-semibold leading-snug text-texto group-hover:text-acento">{c.nombre}</p>
            <p class="text-xs text-tenue">{conteo(c.id)} productos</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mt-12">
    <div class="flex items-end justify-between">
      <h2 class="text-2xl font-bold text-texto">Destacados</h2>
      <a href={url('productos/')} class="text-sm font-semibold text-acento hover:underline">Ver todo →</a>
    </div>
    <div class="mt-4 grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4 2xl:grid-cols-6">
      {destacados.map((p) => <ProductoCard producto={p} client:visible />)}
    </div>
  </section>
</Base>
