---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Página no encontrada">
  <div class="py-16 text-center">
    <p class="text-6xl font-extrabold text-acento">404</p>
    <h1 class="mt-4 text-2xl font-bold">No encontramos esta página</h1>
    <p class="mt-2 text-texto-2">Puede que el producto ya no esté disponible.</p>
    <a href={url('productos/')} class="mt-6 inline-block rounded-lg bg-marca-700 px-5 py-2.5 font-semibold text-white hover:bg-marca-800">Ver productos</a>
  </div>
</Base>
